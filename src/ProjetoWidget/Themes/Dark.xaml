<!-- Menu (manager window) colors, dark mode. Keys must match Light.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <SolidColorBrush x:Key="MenuInk" Color="#F2F2FA" />
    <SolidColorBrush x:Key="MenuInkSoft" Color="#A6E6E6F5" />

    <!-- Deep navy to plum, so the logo colors glow through -->
    <LinearGradientBrush x:Key="MenuBaseBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#14152B" Offset="0" />
        <GradientStop Color="#1D1630" Offset="0.55" />
        <GradientStop Color="#271626" Offset="1" />
    </LinearGradientBrush>
    <sys:Double x:Key="MenuBlobOpacity">0.5</sys:Double>
    <SolidColorBrush x:Key="MenuGlassBrush" Color="#1A0B0B1A" />
    <RadialGradientBrush x:Key="MenuSheenBrush" Center="0.18,0.04" GradientOrigin="0.18,0.04" RadiusX="0.45" RadiusY="0.25">
        <GradientStop Color="#33FFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="MenuRimBrush" Color="#40FFFFFF" />

    <SolidColorBrush x:Key="MenuCardBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="MenuCardHoverBrush" Color="#2BFFFFFF" />
    <SolidColorBrush x:Key="MenuCardBorderBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="MenuCardBorderHoverBrush" Color="#59FFFFFF" />
    <SolidColorBrush x:Key="MenuPanelBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="MenuPillBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="MenuPillHoverBrush" Color="#38FFFFFF" />
    <SolidColorBrush x:Key="MenuRowHoverBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="MenuRowSelectedBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="MenuDividerBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="MenuToggleOffBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="MenuToggleOffBorderBrush" Color="#40FFFFFF" />

    <!-- ===== Widgets on the desktop: smoked glass ===== -->
    <SolidColorBrush x:Key="InkBrush" Color="#F2F2FA" />
    <SolidColorBrush x:Key="InkSoftBrush" Color="#A6E6E6F5" />

    <LinearGradientBrush x:Key="WidgetBodyBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C71C1D33" Offset="0" />
        <GradientStop Color="#A6181729" Offset="0.55" />
        <GradientStop Color="#B8221A30" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WidgetBorderBrush" Color="#47FFFFFF" />
    <sys:Double x:Key="WidgetTintOpacity">0.5</sys:Double>
    <RadialGradientBrush x:Key="WidgetSheenBrush" Center="0.2,0.06" GradientOrigin="0.2,0.06" RadiusX="0.55" RadiusY="0.35">
        <GradientStop Color="#2EFFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="WidgetFaceBrush" Center="0.35,0.3" GradientOrigin="0.35,0.3" RadiusX="0.8" RadiusY="0.8">
        <GradientStop Color="#33FFFFFF" Offset="0" />
        <GradientStop Color="#0DFFFFFF" Offset="1" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="WidgetFaceStrokeBrush" Color="#4DFFFFFF" />
    <SolidColorBrush x:Key="WidgetMinorTickBrush" Color="#59FFFFFF" />
    <SolidColorBrush x:Key="WidgetTrackBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="WidgetDividerBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="WidgetChipBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="WidgetChipBorderBrush" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="WidgetHoverBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="WidgetPillBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="WidgetPillHoverBrush" Color="#47FFFFFF" />
</ResourceDictionary>
