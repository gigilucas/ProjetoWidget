<UserControl x:Class="ProjetoWidget.Widgets.MusicSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource MenuInk}">
    <UserControl.Resources>
        <!-- One selectable music app row -->
        <Style x:Key="AppOption" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="GroupName" Value="MusicApp" />
            <Setter Property="Foreground" Value="{DynamicResource MenuInk}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Row" CornerRadius="14" Background="Transparent" Padding="6,5,10,5" Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="9" Background="{Binding IconBrush}">
                                    <TextBlock Text="{Binding Initial}" FontSize="14" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Status}" FontSize="11.5" Foreground="{DynamicResource MenuInkSoft}" />
                                </StackPanel>
                                <!-- check mark -->
                                <Grid x:Name="Check" Grid.Column="2" Width="22" Height="22" Visibility="Hidden">
                                    <Ellipse Fill="{StaticResource LogoGradient}" />
                                    <Path Data="M6,11.5 L9.5,15 L16,8" Stroke="White" StrokeThickness="2.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource MenuRowHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource MenuRowSelectedBrush}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="Music app" FontSize="15" FontWeight="SemiBold" />
        <TextBlock Text="When you open one of these apps and play, it shows up on the widget by itself."
                   FontSize="12.5" Foreground="{DynamicResource MenuInkSoft}" TextWrapping="Wrap" Margin="0,2,0,8" />
        <ScrollViewer MaxHeight="236" VerticalScrollBarVisibility="Auto" Margin="-6,0,-10,0">
            <ItemsControl x:Name="AppList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Style="{StaticResource AppOption}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                     Checked="App_Checked" Tag="{Binding Id}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </StackPanel>
</UserControl>
