<UserControl x:Class="ProjetoWidget.Widgets.CpuRamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" Foreground="{StaticResource InkBrush}">
    <DockPanel>
        <!-- Header: SYSTEM · Live -->
        <Grid DockPanel.Dock="Top">
            <TextBlock Text="SYSTEM" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}"
                       VerticalAlignment="Center" Margin="2,0,0,0" />
            <Border HorizontalAlignment="Right" CornerRadius="10" Background="#73FFFFFF" BorderBrush="#E6FFFFFF"
                    BorderThickness="1" Padding="7,2,8,3">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource LogoGradient}" VerticalAlignment="Center" />
                    <TextBlock Text="Live" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InkSoftBrush}" Margin="5,0,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Two rings -->
        <UniformGrid Columns="2" VerticalAlignment="Center" Margin="0,6,0,0">
            <StackPanel>
                <ContentControl x:Name="CpuRingHost" Width="74" Height="74" />
                <TextBlock Text="CPU" FontSize="13.5" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,7,0,0" />
                <TextBlock x:Name="CpuSub" Text="—" FontSize="11.5" Foreground="{StaticResource InkSoftBrush}" HorizontalAlignment="Center" />
            </StackPanel>
            <StackPanel>
                <ContentControl x:Name="RamRingHost" Width="74" Height="74" />
                <TextBlock Text="RAM" FontSize="13.5" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,7,0,0" />
                <TextBlock x:Name="RamSub" Text="—" FontSize="11.5" Foreground="{StaticResource InkSoftBrush}" HorizontalAlignment="Center" />
            </StackPanel>
        </UniformGrid>
    </DockPanel>
</UserControl>
