<UserControl x:Class="ProjetoWidget.Widgets.MusicView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource InkBrush}">
    <UserControl.Resources>
        <!-- Icons (24x24) -->
        <Geometry x:Key="ShuffleIcon">M17 3l4 4-4 4V8h-2.5l-7 9H3v-2h3.5l7-9H17zM3 7h3.5l2.2 2.8-1.3 1.6L5.5 9H3zm14 6 4 4-4 4v-3h-3.5l-2.2-2.8 1.3-1.6 1.9 2.4H17z</Geometry>
        <Geometry x:Key="PrevIcon">M6 5h2.5v14H6zm3.5 7L19 5v14z</Geometry>
        <Geometry x:Key="PlayIcon">M8 5v14l11-7z</Geometry>
        <Geometry x:Key="PauseIcon">M7 5h3.5v14H7zm6.5 0H17v14h-3.5z</Geometry>
        <Geometry x:Key="NextIcon">M15.5 5H18v14h-2.5zM5 5l9.5 7L5 19z</Geometry>
        <Geometry x:Key="RepeatIcon">M7 7h10v3l4-4-4-4v3H5v6h2zm10 10H7v-3l-4 4 4 4v-3h12v-6h-2z</Geometry>

        <!-- Borderless icon button -->
        <Style x:Key="MediaButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="10" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource WidgetHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Player -->
        <DockPanel x:Name="PlayerView" Visibility="Collapsed">
            <!-- Song, artist, app -->
            <Grid DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="68" Height="68" CornerRadius="16" Background="{StaticResource LogoGradient}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270" Opacity="0.3" Color="#3C2882" />
                    </Border.Effect>
                    <Grid>
                        <Border x:Name="ArtImage" CornerRadius="16" />
                        <Border CornerRadius="16" IsHitTestVisible="False">
                            <Border.Background>
                                <RadialGradientBrush Center="0.3,0.18" GradientOrigin="0.3,0.18" RadiusX="0.55" RadiusY="0.4">
                                    <GradientStop Color="#80FFFFFF" Offset="0" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,2,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="14.5" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ArtistText" FontSize="12" Foreground="{DynamicResource InkSoftBrush}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                    <Border HorizontalAlignment="Left" CornerRadius="9" Background="{DynamicResource WidgetChipBrush}" BorderBrush="{DynamicResource WidgetChipBorderBrush}"
                            BorderThickness="1" Padding="6,1,8,2" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="SourceDot" Width="6" Height="6" Fill="{StaticResource LogoGradient}" VerticalAlignment="Center" />
                            <TextBlock x:Name="SourceText" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource InkSoftBrush}" Margin="5,0,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Controls -->
            <Grid DockPanel.Dock="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button x:Name="ShuffleButton" Style="{StaticResource MediaButton}" Click="Shuffle_Click" ToolTip="Shuffle"
                        AutomationProperties.Name="Shuffle">
                    <Path x:Name="ShuffleGlyph" Data="{StaticResource ShuffleIcon}" Width="15" Height="15" Stretch="Uniform"
                          Fill="{DynamicResource InkSoftBrush}" />
                </Button>
                <Button x:Name="PreviousButton" Grid.Column="1" Style="{StaticResource MediaButton}" Click="Previous_Click" ToolTip="Previous"
                        AutomationProperties.Name="Previous">
                    <Path Data="{StaticResource PrevIcon}" Width="17" Height="17" Stretch="Uniform" Fill="{DynamicResource InkBrush}" />
                </Button>
                <Button Grid.Column="2" Click="PlayPause_Click" Cursor="Hand" FocusVisualStyle="{x:Null}" ToolTip="Play / Pause"
                        AutomationProperties.Name="Play or pause" Margin="4,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Ellipse x:Name="Disc" Width="44" Height="44" Fill="{StaticResource LogoGradient}">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.35" Color="#FF5FA8" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Disc" Property="Opacity" Value="0.8" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Path x:Name="PlayPauseGlyph" Data="{StaticResource PlayIcon}" Width="18" Height="18" Stretch="Uniform" Fill="White" />
                </Button>
                <Button x:Name="NextButton" Grid.Column="3" Style="{StaticResource MediaButton}" Click="Next_Click" ToolTip="Next"
                        AutomationProperties.Name="Next">
                    <Path Data="{StaticResource NextIcon}" Width="17" Height="17" Stretch="Uniform" Fill="{DynamicResource InkBrush}" />
                </Button>
                <Button x:Name="RepeatButton" Grid.Column="4" Style="{StaticResource MediaButton}" Click="Repeat_Click" ToolTip="Repeat"
                        AutomationProperties.Name="Repeat">
                    <Grid>
                        <Path x:Name="RepeatGlyph" Data="{StaticResource RepeatIcon}" Width="15" Height="15" Stretch="Uniform"
                              Fill="{DynamicResource InkSoftBrush}" />
                        <TextBlock x:Name="RepeatOne" Text="1" FontSize="7" FontWeight="Bold" Foreground="#FF5FA8"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                </Button>
            </Grid>

            <!-- Progress -->
            <StackPanel VerticalAlignment="Center" Margin="0,4">
                <!-- Click or drag to jump in the song. Transparent background makes the whole strip clickable. -->
                <Grid x:Name="Track" Height="16" Background="Transparent" Cursor="Hand"
                      MouseLeftButtonDown="Track_MouseLeftButtonDown" MouseMove="Track_MouseMove"
                      MouseLeftButtonUp="Track_MouseLeftButtonUp" LostMouseCapture="Track_LostMouseCapture">
                    <Border Height="5" CornerRadius="2.5" Background="{DynamicResource WidgetTrackBrush}" />
                    <Border x:Name="Progress" Height="5" CornerRadius="2.5" HorizontalAlignment="Left" Width="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#4F7CFF" Offset="0" />
                                <GradientStop Color="#FF5FA8" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Ellipse x:Name="Knob" Width="10" Height="10" Fill="White" HorizontalAlignment="Left">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.35" Color="#3C2882" />
                        </Ellipse.Effect>
                    </Ellipse>
                </Grid>
                <Grid Margin="0,3,0,0">
                    <TextBlock x:Name="ElapsedText" FontSize="10" Foreground="{DynamicResource InkSoftBrush}" />
                    <TextBlock x:Name="RemainingText" FontSize="10" Foreground="{DynamicResource InkSoftBrush}" HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>
        </DockPanel>

        <!-- Nothing playing -->
        <StackPanel x:Name="IdleView" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border Width="58" Height="58" CornerRadius="16" Background="{StaticResource LogoGradient}" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270" Opacity="0.3" Color="#3C2882" />
                </Border.Effect>
                <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="26" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Not playing" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0" />
            <Button x:Name="OpenAppButton" Click="OpenApp_Click" HorizontalAlignment="Center" Margin="0,8,0,0"
                    Cursor="Hand" FocusVisualStyle="{x:Null}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" CornerRadius="12" Background="{DynamicResource WidgetPillBrush}" BorderBrush="{DynamicResource WidgetChipBorderBrush}" BorderThickness="1" Padding="11,4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource WidgetPillHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock x:Name="OpenAppText" FontSize="12" FontWeight="SemiBold" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
