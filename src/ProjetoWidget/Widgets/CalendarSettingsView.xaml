<UserControl x:Class="ProjetoWidget.Widgets.CalendarSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource MenuInk}">
    <StackPanel>
        <!-- Date: taken from this PC -->
        <Grid>
            <TextBlock Text="Date" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="From this PC" FontSize="15" Foreground="{DynamicResource MenuInkSoft}" HorizontalAlignment="Right" />
        </Grid>

        <Border Style="{StaticResource SettingsDivider}" />

        <!-- Format -->
        <Grid>
            <TextBlock Text="Format" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="dd/mm/yyyy" FontSize="15" Foreground="{DynamicResource MenuInkSoft}" HorizontalAlignment="Right" />
        </Grid>
        <TextBlock x:Name="TodayText" FontSize="12.5" Foreground="{DynamicResource MenuInkSoft}" Margin="0,4,0,0" />

        <Border Style="{StaticResource SettingsDivider}" />

        <!-- First day of the week: from this PC's region settings -->
        <Grid>
            <TextBlock Text="Week starts on" FontSize="15" FontWeight="SemiBold" />
            <TextBlock x:Name="WeekStartText" FontSize="15" Foreground="{DynamicResource MenuInkSoft}" HorizontalAlignment="Right" />
        </Grid>
    </StackPanel>
</UserControl>
