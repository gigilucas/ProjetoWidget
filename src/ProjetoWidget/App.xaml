<Application x:Class="ProjetoWidget.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- Logo palette -->
        <Color x:Key="BlueColor">#4F7CFF</Color>
        <Color x:Key="SkyColor">#3FB8FF</Color>
        <Color x:Key="PinkColor">#FF5FA8</Color>
        <Color x:Key="OrangeColor">#FFB13D</Color>
        <Color x:Key="PurpleColor">#8B5CFF</Color>

        <SolidColorBrush x:Key="InkBrush" Color="#1C1B2E" />
        <SolidColorBrush x:Key="InkSoftBrush" Color="#8C1C1B2E" />

        <LinearGradientBrush x:Key="LogoGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4F7CFF" Offset="0" />
            <GradientStop Color="#FF5FA8" Offset="0.65" />
            <GradientStop Color="#FFB13D" Offset="1" />
        </LinearGradientBrush>

        <FontFamily x:Key="UiFont">Segoe UI Variable Display, Segoe UI</FontFamily>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Apple-style on/off switch -->
        <Style x:Key="AppleToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="52" Height="32" Background="Transparent">
                            <Border x:Name="TrackOff" CornerRadius="16"
                                    Background="#2E1C1B2E" BorderBrush="#80FFFFFF" BorderThickness="1" />
                            <Border x:Name="TrackOn" CornerRadius="16" Opacity="0"
                                    Background="{StaticResource LogoGradient}" BorderBrush="#99FFFFFF" BorderThickness="1" />
                            <Ellipse Width="28" Height="28" Fill="White"
                                     HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="ThumbX" X="0" />
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Direction="270" Opacity="0.28" Color="#3C2882" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbX" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbX" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS-style window buttons -->
        <Style x:Key="TrafficLight" TargetType="Button">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="{TemplateBinding Background}" Stroke="#33000000" StrokeThickness="0.5" />
                            <!-- Symbol drawn as vector lines so it stays sharp at this small size -->
                            <ContentPresenter x:Name="Glyph" Opacity="0"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
