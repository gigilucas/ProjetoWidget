<Window x:Class="ProjetoWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ProjetoWidget"
        Icon="Assets/app.ico"
        Width="440" Height="690"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource InkBrush}"
        UseLayoutRounding="True">

    <!-- Outer margin leaves room for the drop shadow -->
    <Grid Margin="20">
        <Grid.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="10" Direction="270" Opacity="0.32" Color="#3C2882" />
        </Grid.Effect>

        <Grid x:Name="Shell" SizeChanged="Shell_SizeChanged">

            <!-- 1. Soft base gradient -->
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#DFE6FF" Offset="0" />
                        <GradientStop Color="#F3E6F7" Offset="0.55" />
                        <GradientStop Color="#FDEEE2" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- 2. Blurred color blobs, same palette as the logo -->
            <Canvas IsHitTestVisible="False">
                <Canvas.Effect>
                    <BlurEffect Radius="80" KernelType="Gaussian" RenderingBias="Performance" />
                </Canvas.Effect>
                <Ellipse Canvas.Left="-90" Canvas.Top="-70" Width="300" Height="300" Fill="#4F7CFF" />
                <Ellipse Canvas.Left="250" Canvas.Top="-40" Width="220" Height="220" Fill="#E6FFB13D" />
                <Ellipse Canvas.Left="-60" Canvas.Top="380" Width="240" Height="240" Fill="#D98B5CFF" />
                <Ellipse Canvas.Left="200" Canvas.Top="340" Width="300" Height="300" Fill="#FF5FA8" />
            </Canvas>

            <!-- 3. Frosted glass layer + specular sheen -->
            <Rectangle Fill="#4DFFFFFF" IsHitTestVisible="False" />
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.18,0.04" GradientOrigin="0.18,0.04" RadiusX="0.45" RadiusY="0.25">
                        <GradientStop Color="#D9FFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- 4. Content -->
            <DockPanel Margin="26,20,26,24">

                <!-- Title bar (drag area) -->
                <Grid DockPanel.Dock="Top" Height="28" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button Style="{StaticResource TrafficLight}" Background="#FF5F57" ToolTip="Close" AutomationProperties.Name="Close" Click="Close_Click">
                            <!-- 14x14 box, same as the circle, symbol centered on (7,7) -->
                            <Path Width="14" Height="14" Stretch="None" Data="M3.75,3.75 L10.25,10.25 M10.25,3.75 L3.75,10.25"
                                  Stroke="#7A0F0A" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                        <Button Style="{StaticResource TrafficLight}" Background="#FEBC2E" ToolTip="Minimize" AutomationProperties.Name="Minimize" Click="Minimize_Click" Margin="8,0,0,0">
                            <Path Width="14" Height="14" Stretch="None" Data="M3.25,7 L10.75,7"
                                  Stroke="#7A4A00" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Header -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,14,0,22"
                            Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Image Source="Assets/logo.png" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="4" Direction="270" Opacity="0.25" Color="#3C2882" />
                        </Image.Effect>
                    </Image>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ProjetoWidget" FontSize="26" FontWeight="Bold" />
                        <TextBlock Text="Desktop widgets" FontSize="15" Foreground="{StaticResource InkSoftBrush}" Margin="1,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Pages: the widget list, and the settings view of one widget -->
                <Grid ClipToBounds="True">

                <!-- Page 1: widget list -->
                <DockPanel x:Name="ListPage">
                    <DockPanel.RenderTransform><TranslateTransform /></DockPanel.RenderTransform>

                <!-- Footer -->
                <TextBlock x:Name="Summary" DockPanel.Dock="Bottom" HorizontalAlignment="Center" Margin="0,8,0,0"
                           FontSize="13" Foreground="{StaticResource InkSoftBrush}" />

                <!-- Widget list: click a row to open its settings, click the switch to show/hide it -->
                <ItemsControl x:Name="WidgetList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="14,12,16,12" Margin="0,0,0,10" Cursor="Hand"
                                    MouseLeftButtonUp="WidgetRow_MouseLeftButtonUp" ToolTip="Open settings">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="22" />
                                        <Setter Property="Background" Value="#66FFFFFF" />
                                        <Setter Property="BorderBrush" Value="#BFFFFFFF" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#99FFFFFF" />
                                                <Setter Property="BorderBrush" Value="#F2FFFFFF" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="40" Height="40" CornerRadius="12" Background="{Binding IconBrush}">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.22" Color="#3C2882" />
                                        </Border.Effect>
                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="19"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="14,0,0,0" />

                                    <CheckBox Grid.Column="2" Style="{StaticResource AppleToggle}" VerticalAlignment="Center"
                                              IsChecked="{Binding IsOn, Mode=TwoWay}" ToolTip="Show or hide this widget" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </DockPanel>

                <!-- Page 2: settings of one widget (DataContext = the WidgetOption) -->
                <DockPanel x:Name="DetailPage" Visibility="Collapsed">
                    <DockPanel.RenderTransform><TranslateTransform /></DockPanel.RenderTransform>

                    <!-- Back -->
                    <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Click="Back_Click" Cursor="Hand"
                            AutomationProperties.Name="Back"
                            FocusVisualStyle="{x:Null}" ToolTip="Back to all widgets">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Pill" CornerRadius="15" Background="#59FFFFFF" BorderBrush="#BFFFFFFF"
                                        BorderThickness="1" Padding="10,5,14,5">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="10" Height="14" Stretch="None" Data="M7,2 L2,7 L7,12" Stroke="{StaticResource InkBrush}"
                                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              VerticalAlignment="Center" />
                                        <TextBlock Text="Widgets" FontSize="14" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Pill" Property="Background" Value="#99FFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Widget title -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,14,0,14">
                        <Border Width="56" Height="56" CornerRadius="16" Background="{Binding IconBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="3" Direction="270" Opacity="0.25" Color="#3C2882" />
                            </Border.Effect>
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="26"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding Name}" FontSize="26" FontWeight="Bold" VerticalAlignment="Center" Margin="16,0,0,0" />
                    </StackPanel>

                    <!-- Show on desktop -->
                    <Border DockPanel.Dock="Top" CornerRadius="22" Background="#66FFFFFF" BorderBrush="#BFFFFFFF" BorderThickness="1"
                            Padding="18,14,16,14" Margin="0,0,0,12">
                        <Grid>
                            <TextBlock Text="Show on desktop" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <CheckBox Style="{StaticResource AppleToggle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      IsChecked="{Binding IsOn, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <!-- Settings area: one set of options per widget -->
                    <Border CornerRadius="22" Background="#40FFFFFF" BorderBrush="#BFFFFFFF" BorderThickness="1" Padding="18,14"
                            VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="SETTINGS" FontSize="13" FontWeight="Bold" Foreground="{StaticResource InkSoftBrush}" Margin="0,0,0,12" />
                            <ContentControl x:Name="SettingsHost" />
                        </StackPanel>
                    </Border>
                </DockPanel>
                </Grid>
            </DockPanel>

            <!-- 5. Glass rim -->
            <Border x:Name="Rim" CornerRadius="34" BorderBrush="#CCFFFFFF" BorderThickness="1.5" IsHitTestVisible="False" />
        </Grid>
    </Grid>
</Window>
