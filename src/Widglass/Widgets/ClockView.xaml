<UserControl x:Class="Widglass.Widgets.ClockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource InkBrush}">
    <Grid>

        <!-- Analog: face with hour, minute and second hands -->
        <Viewbox x:Name="AnalogView">
            <Canvas Width="200" Height="200">
                <Ellipse Width="200" Height="200" Stroke="{DynamicResource WidgetFaceStrokeBrush}" StrokeThickness="2" Fill="{DynamicResource WidgetFaceBrush}">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.18" Color="#3C2882" />
                    </Ellipse.Effect>
                </Ellipse>

                <Canvas x:Name="Ticks" />

                <!-- 40x24 boxes centered on the number positions -->
                <TextBlock Text="12" FontSize="17" FontWeight="SemiBold" Width="40" Height="24" TextAlignment="Center" Canvas.Left="80" Canvas.Top="18" />
                <TextBlock Text="3" FontSize="17" FontWeight="SemiBold" Width="40" Height="24" TextAlignment="Center" Canvas.Left="148" Canvas.Top="87" />
                <TextBlock Text="6" FontSize="17" FontWeight="SemiBold" Width="40" Height="24" TextAlignment="Center" Canvas.Left="80" Canvas.Top="157" />
                <TextBlock Text="9" FontSize="17" FontWeight="SemiBold" Width="40" Height="24" TextAlignment="Center" Canvas.Left="12" Canvas.Top="87" />

                <!-- Hour hand (logo gradient) -->
                <Line X1="100" Y1="100" X2="100" Y2="54" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Line.Stroke>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                            <GradientStop Color="#4F7CFF" Offset="0" />
                            <GradientStop Color="#FF5FA8" Offset="1" />
                        </LinearGradientBrush>
                    </Line.Stroke>
                    <Line.RenderTransform><RotateTransform x:Name="HourHand" CenterX="100" CenterY="100" /></Line.RenderTransform>
                </Line>
                <!-- Minute hand -->
                <Line X1="100" Y1="100" X2="100" Y2="30" Stroke="{DynamicResource InkBrush}" StrokeThickness="4.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Line.RenderTransform><RotateTransform x:Name="MinuteHand" CenterX="100" CenterY="100" /></Line.RenderTransform>
                </Line>
                <!-- Second hand -->
                <Line X1="100" Y1="114" X2="100" Y2="24" Stroke="#FFB13D" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Line.RenderTransform><RotateTransform x:Name="SecondHand" CenterX="100" CenterY="100" /></Line.RenderTransform>
                </Line>
                <Ellipse Width="12" Height="12" Canvas.Left="94" Canvas.Top="94" Fill="#FFB13D" Stroke="White" StrokeThickness="2" />
            </Canvas>
        </Viewbox>

        <!-- Digital: big time, seconds and the date -->
        <StackPanel x:Name="DigitalView" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="TimeText" FontSize="60" FontWeight="Light" />
                <TextBlock x:Name="SecondsText" FontSize="22" FontWeight="SemiBold" Margin="4,0,0,12"
                           VerticalAlignment="Bottom" Foreground="{DynamicResource InkSoftBrush}" />
            </StackPanel>
            <TextBlock x:Name="DayText" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0">
                <TextBlock.Foreground>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#4F7CFF" Offset="0" />
                        <GradientStop Color="#FF5FA8" Offset="1" />
                    </LinearGradientBrush>
                </TextBlock.Foreground>
            </TextBlock>
            <TextBlock x:Name="DateText" FontSize="15" Foreground="{DynamicResource InkSoftBrush}" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
