<UserControl x:Class="Widglass.Widgets.WeatherSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource MenuInk}">
    <StackPanel>
        <!-- Location: from Windows location services -->
        <Grid>
            <TextBlock Text="Location" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="From this PC" FontSize="15" Foreground="{DynamicResource MenuInkSoft}" HorizontalAlignment="Right" />
        </Grid>
        <TextBlock x:Name="LocationStatus" Text="Checking…" FontSize="12.5" Foreground="{DynamicResource MenuInkSoft}"
                   TextWrapping="Wrap" Margin="0,4,0,0" />
        <Button x:Name="OpenLocationSettings" Click="OpenLocationSettings_Click" HorizontalAlignment="Left" Margin="0,8,0,0"
                Cursor="Hand" FocusVisualStyle="{x:Null}" Visibility="Collapsed">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Pill" CornerRadius="13" Background="{StaticResource LogoGradient}" Padding="12,5">
                        <TextBlock Text="Open location settings" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Border Style="{StaticResource SettingsDivider}" />

        <Grid>
            <TextBlock Text="Units" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="Celsius (°C)" FontSize="15" Foreground="{DynamicResource MenuInkSoft}" HorizontalAlignment="Right" />
        </Grid>

        <Border Style="{StaticResource SettingsDivider}" />

        <Grid>
            <TextBlock Text="Updates" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="Every 15 minutes" FontSize="15" Foreground="{DynamicResource MenuInkSoft}" HorizontalAlignment="Right" />
        </Grid>
        <TextBlock Text="Forecast by Open-Meteo." FontSize="12.5" Foreground="{DynamicResource MenuInkSoft}" Margin="0,4,0,0" />
    </StackPanel>
</UserControl>
