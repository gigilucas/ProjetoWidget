<UserControl x:Class="Widglass.Widgets.ClockSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource MenuInk}">
    <StackPanel>
        <!-- Time zone: taken from this PC -->
        <Grid>
            <TextBlock Text="Time zone" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="From this PC" FontSize="15" Foreground="{DynamicResource MenuInkSoft}" HorizontalAlignment="Right" />
        </Grid>
        <TextBlock x:Name="ZoneText" FontSize="12.5" Foreground="{DynamicResource MenuInkSoft}" TextWrapping="Wrap" Margin="0,4,0,0" />

        <Border Style="{StaticResource SettingsDivider}" />

        <!-- Style: analog (three hands) or digital -->
        <TextBlock Text="Style" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
        <Border CornerRadius="14" Background="{DynamicResource MenuPanelBrush}" BorderBrush="{DynamicResource MenuCardBorderBrush}" BorderThickness="1" Padding="3">
            <UniformGrid Columns="2">
                <RadioButton x:Name="AnalogOption" Style="{StaticResource SegmentOption}" Content="Analog"
                             GroupName="ClockStyle" Checked="Style_Checked" />
                <RadioButton x:Name="DigitalOption" Style="{StaticResource SegmentOption}" Content="Digital"
                             GroupName="ClockStyle" Checked="Style_Checked" />
            </UniformGrid>
        </Border>
        <TextBlock x:Name="StyleHint" FontSize="12.5" Foreground="{DynamicResource MenuInkSoft}" Margin="2,6,0,0" />
    </StackPanel>
</UserControl>
