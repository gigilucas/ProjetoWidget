<UserControl x:Class="Widglass.Widgets.CurrencyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Widglass.Widgets"
             FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource InkBrush}">
    <Grid>
        <DockPanel x:Name="RateView" Visibility="Collapsed">
            <!-- EUR → USD, and whether the market is trading -->
            <Grid DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal" Margin="2,0,0,0">
                    <TextBlock x:Name="FromText" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource InkSoftBrush}"
                               VerticalAlignment="Center" Margin="6,1,6,0" />
                    <TextBlock x:Name="ToText" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="10" Background="{DynamicResource WidgetChipBrush}"
                        BorderBrush="{DynamicResource WidgetChipBorderBrush}" BorderThickness="1" Padding="7,2,8,3">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="MarketDot" Width="6" Height="6" VerticalAlignment="Center" />
                        <TextBlock x:Name="MarketText" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource InkSoftBrush}" Margin="5,0,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- €100.00 = $109.40 -->
            <StackPanel DockPanel.Dock="Top" Margin="2,8,0,2">
                <TextBlock x:Name="AmountText" FontSize="12.5" Foreground="{DynamicResource InkSoftBrush}" TextTrimming="CharacterEllipsis" />
                <Border x:Name="ResultFlash" HorizontalAlignment="Left" CornerRadius="8" Padding="4,0" Margin="-4,-1,0,0" Background="Transparent">
                    <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" MaxWidth="188">
                        <TextBlock x:Name="ResultText" FontSize="27" FontWeight="SemiBold" />
                    </Viewbox>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,-1,0,0">
                    <TextBlock x:Name="RateText" FontSize="11.5" Foreground="{DynamicResource InkSoftBrush}" />
                    <TextBlock x:Name="ChangeText" FontSize="11.5" FontWeight="SemiBold" Margin="7,0,0,0" />
                </StackPanel>
            </StackPanel>

            <local:StockChart x:Name="Chart" Margin="0,4,0,0" />
        </DockPanel>

        <!-- Loading / no data -->
        <StackPanel x:Name="MessageView" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border Width="54" Height="54" CornerRadius="16" Background="{StaticResource LogoGradient}" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270" Opacity="0.3" Color="#3C2882" />
                </Border.Effect>
                <TextBlock Text="&#xE8AB;" FontFamily="{StaticResource IconFont}" FontSize="24" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="MessageTitle" Text="Loading…" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0" />
            <TextBlock x:Name="MessageText" FontSize="11.5" Foreground="{DynamicResource InkSoftBrush}" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="170" Margin="0,2,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
