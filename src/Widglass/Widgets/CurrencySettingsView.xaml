<UserControl x:Class="Widglass.Widgets.CurrencySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource MenuInk}">
    <UserControl.Resources>
        <!-- "From" / "To" box: click one, then pick its currency below -->
        <Style x:Key="SideOption" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="GroupName" Value="CurrencySide" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box" CornerRadius="14" Padding="12,8" BorderThickness="1"
                                Background="{DynamicResource MenuPanelBrush}" BorderBrush="{DynamicResource MenuCardBorderBrush}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource MenuRowHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource MenuRowSelectedBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource MenuCardBorderHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Amount -->
        <TextBlock Text="Amount" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
        <Grid>
            <Border CornerRadius="12" Background="{DynamicResource MenuPanelBrush}" BorderBrush="{DynamicResource MenuCardBorderBrush}" BorderThickness="1" />
            <TextBlock x:Name="AmountSymbol" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MenuInkSoft}"
                       VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False" />
            <TextBox x:Name="AmountBox" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MenuInk}" CaretBrush="{DynamicResource MenuInk}"
                     Background="Transparent" BorderThickness="0" Padding="40,8,10,8" VerticalContentAlignment="Center"
                     TextChanged="AmountBox_TextChanged" AutomationProperties.Name="Amount" />
        </Grid>
        <TextBlock x:Name="AmountHint" Text="Type a number, like 100 or 2,50." FontSize="12" Foreground="{DynamicResource MenuInkSoft}"
                   Margin="2,6,0,0" Visibility="Collapsed" />

        <Border Style="{StaticResource SettingsDivider}" />

        <!-- From ⇄ To -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <RadioButton x:Name="FromSide" Style="{StaticResource SideOption}" Checked="Side_Checked">
                <StackPanel>
                    <TextBlock Text="From" FontSize="12" Foreground="{DynamicResource MenuInkSoft}" />
                    <TextBlock x:Name="FromCode" FontSize="18" FontWeight="Bold" />
                    <TextBlock x:Name="FromName" FontSize="12" Foreground="{DynamicResource MenuInkSoft}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </RadioButton>

            <Button Grid.Column="1" Click="Swap_Click" Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="8,0" VerticalAlignment="Center"
                    ToolTip="Swap" AutomationProperties.Name="Swap currencies">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Circle" Width="34" Height="34" CornerRadius="17" Background="{StaticResource LogoGradient}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.25" Color="#3C2882" />
                            </Border.Effect>
                            <TextBlock Text="&#xE8AB;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <RadioButton x:Name="ToSide" Grid.Column="2" Style="{StaticResource SideOption}" Checked="Side_Checked">
                <StackPanel>
                    <TextBlock Text="To" FontSize="12" Foreground="{DynamicResource MenuInkSoft}" />
                    <TextBlock x:Name="ToCode" FontSize="18" FontWeight="Bold" />
                    <TextBlock x:Name="ToName" FontSize="12" Foreground="{DynamicResource MenuInkSoft}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </RadioButton>
        </Grid>

        <TextBlock x:Name="PickHint" FontSize="12" Foreground="{DynamicResource MenuInkSoft}" Margin="2,10,0,6" />

        <!-- Currency grid -->
        <ItemsControl x:Name="Currencies" Margin="-3,0,-3,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Click="Currency_Click" Tag="{Binding Code}" ToolTip="{Binding Name}" Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="3">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Chip" CornerRadius="11" Padding="0,5" BorderThickness="1"
                                        Background="{DynamicResource MenuPillBrush}" BorderBrush="{DynamicResource MenuCardBorderBrush}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="Code" Text="{Binding Code}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource MenuInk}" />
                                        <TextBlock x:Name="Sign" Text="{Binding Sign}" FontSize="11" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource MenuInkSoft}" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Chip" Property="Background" Value="{DynamicResource MenuPillHoverBrush}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="Chip" Property="Background" Value="{StaticResource LogoGradient}" />
                                        <Setter TargetName="Chip" Property="BorderBrush" Value="Transparent" />
                                        <Setter TargetName="Code" Property="Foreground" Value="White" />
                                        <Setter TargetName="Sign" Property="Foreground" Value="#DDFFFFFF" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsOther}" Value="True">
                                        <Setter TargetName="Chip" Property="Opacity" Value="0.4" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Live rates from Yahoo Finance, refreshed every few seconds while markets trade (currencies on weekdays, crypto every day)."
                   FontSize="12" Foreground="{DynamicResource MenuInkSoft}" TextWrapping="Wrap" Margin="2,10,0,0" />
    </StackPanel>
</UserControl>
