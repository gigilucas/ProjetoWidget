<UserControl x:Class="Widglass.Widgets.PhotosSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource MenuInk}">
    <UserControl.Resources>
        <!-- Glass pill button: "Add photos", "Add folder" -->
        <Style x:Key="AddButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" CornerRadius="12" Padding="10,8" BorderThickness="1"
                                Background="{DynamicResource MenuPanelBrush}" BorderBrush="{DynamicResource MenuCardBorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource MenuRowHoverBrush}" />
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource MenuCardBorderHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small round "remove" button -->
        <Style x:Key="RemoveButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ToolTip" Value="Remove" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Circle" Width="24" Height="24" CornerRadius="12" Background="Transparent">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{DynamicResource MenuInkSoft}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="{DynamicResource MenuPillHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- How many photo frames on the desktop -->
        <TextBlock Text="Frames on the desktop" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
        <Border CornerRadius="14" Background="{DynamicResource MenuPanelBrush}" BorderBrush="{DynamicResource MenuCardBorderBrush}" BorderThickness="1" Padding="3">
            <UniformGrid Columns="5">
                <RadioButton x:Name="Frames1" Style="{StaticResource SegmentOption}" Content="1" Tag="1" GroupName="PhotoFrames" Checked="Frames_Checked" />
                <RadioButton x:Name="Frames2" Style="{StaticResource SegmentOption}" Content="2" Tag="2" GroupName="PhotoFrames" Checked="Frames_Checked" />
                <RadioButton x:Name="Frames3" Style="{StaticResource SegmentOption}" Content="3" Tag="3" GroupName="PhotoFrames" Checked="Frames_Checked" />
                <RadioButton x:Name="Frames4" Style="{StaticResource SegmentOption}" Content="4" Tag="4" GroupName="PhotoFrames" Checked="Frames_Checked" />
                <RadioButton x:Name="Frames5" Style="{StaticResource SegmentOption}" Content="5" Tag="5" GroupName="PhotoFrames" Checked="Frames_Checked" />
            </UniformGrid>
        </Border>
        <TextBlock x:Name="FramesHint" FontSize="12" Foreground="{DynamicResource MenuInkSoft}" TextWrapping="Wrap" Margin="2,6,0,0" />

        <!-- Which frame the options below change (only with 2 or more) -->
        <StackPanel x:Name="FramePickerPanel" Margin="0,12,0,0">
            <TextBlock Text="Editing frame" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
            <Border CornerRadius="14" Background="{DynamicResource MenuPanelBrush}" BorderBrush="{DynamicResource MenuCardBorderBrush}" BorderThickness="1" Padding="3">
                <UniformGrid x:Name="FramePicker" Rows="1" />
            </Border>
        </StackPanel>

        <Border Style="{StaticResource SettingsDivider}" />

        <!-- Photos: files and folders -->
        <Grid>
            <TextBlock Text="Photos" FontSize="15" FontWeight="SemiBold" />
            <TextBlock x:Name="TotalText" FontSize="13" Foreground="{DynamicResource MenuInkSoft}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <!-- Preview of the first photos -->
        <UniformGrid x:Name="Preview" Columns="4" Margin="-3,8,-3,0" />

        <ItemsControl x:Name="Sources" Margin="-4,6,-4,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="12" Padding="8,5,4,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{DynamicResource MenuInkSoft}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding Path}" FontSize="13.5" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0,8,0" />
                            <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource MenuInkSoft}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <Button Grid.Column="3" Style="{StaticResource RemoveButton}" Tag="{Binding Path}" Click="Remove_Click" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <UniformGrid Columns="2" Margin="-3,8,-3,0">
            <Button Style="{StaticResource AddButton}" Click="AddPhotos_Click" Margin="3,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE91B;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource MenuInk}" />
                    <TextBlock Text="Add photos" FontSize="13.5" FontWeight="SemiBold" Margin="8,0,0,0" Foreground="{DynamicResource MenuInk}" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource AddButton}" Click="AddFolder_Click" Margin="3,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource MenuInk}" />
                    <TextBlock Text="Add folder" FontSize="13.5" FontWeight="SemiBold" Margin="8,0,0,0" Foreground="{DynamicResource MenuInk}" />
                </StackPanel>
            </Button>
        </UniformGrid>
        <TextBlock Text="New photos added to a folder show up on their own." FontSize="12" Foreground="{DynamicResource MenuInkSoft}"
                   TextWrapping="Wrap" Margin="2,6,0,0" />

        <Border Style="{StaticResource SettingsDivider}" />

        <!-- How long each photo stays -->
        <TextBlock Text="Change every" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
        <Border CornerRadius="14" Background="{DynamicResource MenuPanelBrush}" BorderBrush="{DynamicResource MenuCardBorderBrush}" BorderThickness="1" Padding="3">
            <UniformGrid Columns="4">
                <RadioButton x:Name="Every5" Style="{StaticResource SegmentOption}" Content="5 s" Tag="5" GroupName="PhotoInterval" Checked="Interval_Checked" />
                <RadioButton x:Name="Every15" Style="{StaticResource SegmentOption}" Content="15 s" Tag="15" GroupName="PhotoInterval" Checked="Interval_Checked" />
                <RadioButton x:Name="Every60" Style="{StaticResource SegmentOption}" Content="1 min" Tag="60" GroupName="PhotoInterval" Checked="Interval_Checked" />
                <RadioButton x:Name="Every300" Style="{StaticResource SegmentOption}" Content="5 min" Tag="300" GroupName="PhotoInterval" Checked="Interval_Checked" />
            </UniformGrid>
        </Border>

        <!-- Shape -->
        <TextBlock Text="Shape" FontSize="15" FontWeight="SemiBold" Margin="0,14,0,8" />
        <Border CornerRadius="14" Background="{DynamicResource MenuPanelBrush}" BorderBrush="{DynamicResource MenuCardBorderBrush}" BorderThickness="1" Padding="3">
            <UniformGrid Columns="2">
                <RadioButton x:Name="SquareOption" Style="{StaticResource SegmentOption}" Content="Square" GroupName="PhotoShape" Checked="Shape_Checked" />
                <RadioButton x:Name="WideOption" Style="{StaticResource SegmentOption}" Content="Wide" GroupName="PhotoShape" Checked="Shape_Checked" />
            </UniformGrid>
        </Border>

        <Border Style="{StaticResource SettingsDivider}" />

        <!-- Shuffle -->
        <Grid>
            <StackPanel>
                <TextBlock Text="Shuffle" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="Random order instead of by name." FontSize="12" Foreground="{DynamicResource MenuInkSoft}" Margin="0,2,0,0" />
            </StackPanel>
            <CheckBox x:Name="ShuffleToggle" Style="{StaticResource AppleToggle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                      Checked="Shuffle_Changed" Unchecked="Shuffle_Changed" />
        </Grid>
    </StackPanel>
</UserControl>
