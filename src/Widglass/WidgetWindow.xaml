<Window x:Class="Widglass.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="252" Height="252"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        UseLayoutRounding="True">

    <!-- Empty glass card for now; the widget content comes later. Margin leaves room for the shadow. -->
    <Grid Margin="16" Cursor="SizeAll" Background="Transparent"
          MouseLeftButtonDown="Card_MouseLeftButtonDown" MouseMove="Card_MouseMove"
          MouseLeftButtonUp="Card_MouseLeftButtonUp" LostMouseCapture="Card_LostMouseCapture">
        <Grid.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.28" Color="#3C2882" />
        </Grid.Effect>

        <!-- Frosted glass body -->
        <Border CornerRadius="48" BorderBrush="{DynamicResource WidgetBorderBrush}" BorderThickness="1.5" Background="{DynamicResource WidgetBodyBrush}">
        </Border>

        <!-- Iridescent tint at the bottom, in the logo colors -->
        <Border CornerRadius="48" IsHitTestVisible="False" Opacity="{DynamicResource WidgetTintOpacity}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0.4" EndPoint="1,1">
                    <GradientStop Color="#004F7CFF" Offset="0" />
                    <GradientStop Color="#664F7CFF" Offset="0.45" />
                    <GradientStop Color="#66FF5FA8" Offset="0.75" />
                    <GradientStop Color="#66FFB13D" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Specular sheen, top-left like the logo -->
        <Border CornerRadius="48" IsHitTestVisible="False" Background="{DynamicResource WidgetSheenBrush}" />

        <!-- Widget content (clock, calendar, ...). Not hit-testable, so the whole card stays draggable. -->
        <ContentControl x:Name="Host" Margin="18" IsHitTestVisible="False" />
    </Grid>
</Window>
